# 运行时日志（守护脚本每次运行都会写）
ops/logs/

# 截图用的临时副本 / chromium profile（每次跑 shot_*.py 都会重建）
ops/_tmp/

# 截图产物：本地核对用，不进库
ops/shots/
*.log

# APK 构建中间产物
android/output/

# 签名密钥：不进版本库，必须单独备份（丢了就无法覆盖安装升级）
private/

# 本地工作笔记（WorkBuddy 用的项目记忆，不进版本库）
.workbuddy/

# 用户拍的参考照片（体积大且是私人素材，只做开发参考，不进版本库）
MVIMG_*.jpg
IMG_*.jpg

# Python / 编辑器 / 系统
__pycache__/
*.pyc
.DS_Store
Thumbs.db
